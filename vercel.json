{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{public/**,server/templates/**,server/schema.sql}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
