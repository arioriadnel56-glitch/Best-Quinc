# --- Serveur ---
PORT=3000
# Derrière un proxy (Render, Railway, Heroku) : true. Sur Vercel : automatique (inutile de le renseigner).
TRUST_PROXY=false
# Adresse publique du site, utilisée dans les liens de factures envoyés par WhatsApp (ex. https://best-quinca.vercel.app ou votre domaine)
# Si vide, elle est déduite de la requête.
PUBLIC_URL=
# Frontend hébergé à part (Cloudflare Pages…) : adresses autorisées à appeler l'API et à ouvrir le temps réel, séparées par des virgules, sans barre finale.
# Vide = site et API sur le même domaine (fonctionnement historique). Voir DEPLOIEMENT-GRATUIT.md
FRONTEND_ORIGIN=

# --- Base de données PostgreSQL ---
# En local : postgres://postgres:postgres@localhost:5432/bestquinca
# Avec Neon : collez la chaîne de connexion « Pooled connection » (hôte contenant -pooler), elle se termine par ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bestquinca
# Mettre true si l'hébergeur impose SSL sans l'indiquer dans l'URL (inutile avec Neon : sslmode=require est déjà dans l'URL)
PGSSL=false
# Temps réel (WebSocket sur /ws). Actif par défaut sur un serveur permanent ; impossible sur Vercel. false pour le couper.
WS_ENABLED=
# Connexions simultanées par instance (défaut : 5 sur Vercel, 10 ailleurs)
PG_POOL_MAX=
# Crée/met à jour les tables au premier appel de chaque instance (défaut : true). Mettre false pour ne migrer que par `npm run migrate`.
AUTO_MIGRATE=true

# --- Sécurité ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Abonnement : deux formules (valeurs par défaut ; modifiables dans /admin → Paramètres) ---
# Mensuelle : 5 000 F CFA pour 30 jours — Annuelle : 50 000 F CFA pour 365 jours
SUBSCRIPTION_PRICE=5000
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_PRICE_ANNUAL=50000
SUBSCRIPTION_DAYS_ANNUAL=365
# Jours d'essai gratuit à l'inscription (0 = aucun)
TRIAL_DAYS=0

# --- Super admin (premier démarrage) ---
# Crée le compte du super admin s'il n'en existe aucun. Une fois connecté sur /admin,
# RETIREZ SUPERADMIN_PASSWORD de cette configuration. (Mot de passe : 10 caractères minimum)
SUPERADMIN_EMAIL=
# Mettre true une fois pour recréer ce compte / remettre son mot de passe, puis retirer
SUPERADMIN_RESET=
SUPERADMIN_PASSWORD=
SUPERADMIN_NOM=Super administrateur

# --- KkiaPay (https://kkiapay.me) ---
# FACULTATIF : les clés se saisissent normalement dans l'espace super admin (/admin → Paramètres).
# Les valeurs ci-dessous ne servent que de secours si rien n'est enregistré là-bas.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
# "Secret" défini dans le tableau de bord KkiaPay, onglet webhooks
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# --- FedaPay (https://fedapay.com) ---
# FACULTATIF : les clés se saisissent normalement dans l'espace super admin (/admin → Paramètres).
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_SANDBOX=true

# --- Sécurité ---
# Nombre de proxys de confiance devant le serveur (1 = l'hébergeur seul : Render, Railway, Nginx…).
# Sert à lire la vraie adresse IP du client pour la limitation des tentatives de connexion.
# Utilisez TRUST_PROXY=true uniquement si le serveur n'est joignable QUE derrière ce proxy.
TRUSTED_PROXY_HOPS=1

# --- Application Android (Google Play) : voir PLAYSTORE.md ---
# Nom du paquet choisi à la création de l'application et empreinte(s) SHA-256 du certificat de signature (Play Console → Signature d'application)
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
# Éditeur et contact affichés dans les pages légales (/confidentialite, /conditions, /supprimer-mon-compte)
CONTACT_EMAIL=
EDITEUR_NOM=

# --- Hébergement derrière un proxy (Render, Railway…) ---
# En-tête posé par le proxy frontal avec l'adresse réelle du visiteur. Render : cf-connecting-ip
TRUSTED_IP_HEADER=
